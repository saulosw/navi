{
  "name": "navi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,desktop \"npm run dev -w @navi/api\" \"npm run dev -w @navi/desktop\"",
    "dev:api": "npm run dev -w @navi/api",
    "dev:desktop": "npm run dev -w @navi/desktop",
    "build": "npm run typecheck && npm run build -w @navi/desktop",
    "typecheck": "tsc -p apps/api/tsconfig.json && tsc -p apps/desktop/tsconfig.json && tsc -p packages/contracts/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture": "depcruise apps/api/src apps/desktop/src packages/contracts/src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run architecture && npm run typecheck && npm run test:coverage",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @navi/api",
    "package:desktop": "npm run package -w @navi/desktop",
    "setup:env": "node scripts/setup-env.mjs",
    "test:integration": "node --env-file-if-exists=.env scripts/database-smoke.mjs",
    "postinstall": "node scripts/setup-electron.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
